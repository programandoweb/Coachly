# El frontend habla directo con Laravel desde el navegador (sin API routes de Next).
NEXT_PUBLIC_LARAVEL_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cookie legible por el navegador donde se guarda el token (respaldo de localStorage).
NEXT_PUBLIC_FIT_BROWSER_TOKEN_COOKIE_NAME=coachly_bearer_token

# Logs detallados de cada petición a Laravel en la consola del navegador.
NEXT_PUBLIC_FIT_DEBUG_API=false
